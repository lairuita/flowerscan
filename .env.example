# Copy this file to .env.local for local development with `vercel dev`
# Set all of these in your Vercel project dashboard for production

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price IDs — create these manually in your Stripe dashboard
STRIPE_STARTER_PRICE_ID=price_xxx        # One-time, $65 CAD
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx   # Recurring bi-weekly, $55 CAD
STRIPE_WORKSHOP_PRICE_ID=price_xxx       # One-time, $85 CAD

# ── Airtable ──────────────────────────────────────────────────
AIRTABLE_API_KEY=xxx
AIRTABLE_BASE_ID=appxxx
AIRTABLE_SUBSCRIBERS_TABLE=Subscribers
AIRTABLE_WORKSHOPS_TABLE=Workshop Bookings

# ── Resend ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ── Domain ────────────────────────────────────────────────────
YOUR_DOMAIN=https://flowerscan.ca
