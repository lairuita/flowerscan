# Copy this file to .env.local for local development with `vercel dev`
# Set all of these in your Vercel project dashboard for production

# ── Stripe ────────────────────────────────────────────────────
# Secret key from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxx

# Payment Link IDs (pl_xxx) — Dashboard → Payment Links → click each link
# These are used to count sold tickets and show "Sold out" automatically
STRIPE_LYCHUU_PAYMENT_LINK_ID=pl_xxx
STRIPE_COFFEE_RONIN_PAYMENT_LINK_ID=pl_xxx

# ── Helcim ────────────────────────────────────────────────────
HELCIM_API_TOKEN=xxx
HELCIM_ACCOUNT_ID=xxx

# Amounts in cents (6500 = $65.00 CAD)
HELCIM_STARTER_AMOUNT=6500
HELCIM_SUBSCRIPTION_AMOUNT=5500
HELCIM_WORKSHOP_AMOUNT=8500

# ── Google Sheets ─────────────────────────────────────────────
# The long ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/GOOGLE_SHEET_ID/edit
GOOGLE_SHEET_ID=xxx

# From your Google Cloud service account JSON file
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com

# Paste the private_key value from the service account JSON.
# Keep the -----BEGIN/END----- lines. Use \n for newlines in Vercel.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----"

# Sheet tab names (must match exactly in your spreadsheet)
AIRTABLE_SUBSCRIBERS_TABLE=Subscribers
AIRTABLE_WORKSHOPS_TABLE=Workshop Bookings

# ── Resend ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ── Domain ────────────────────────────────────────────────────
YOUR_DOMAIN=https://www.flowerscan.ca
